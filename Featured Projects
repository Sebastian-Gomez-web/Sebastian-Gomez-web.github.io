<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Featured Projects | Before & After Gallery - Sebastian Gomez Welding</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background: #eef2f0;
      color: #1e2a3a;
      padding: 2rem 1rem;
    }
    .gallery-container {
      max-width: 1200px;
      margin: 0 auto;
      background: white;
      border-radius: 2rem;
      padding: 2rem;
      box-shadow: 0 20px 35px -10px rgba(0,0,0,0.1);
    }
    h1 {
      font-size: 2rem;
      color: #2c3e3f;
      border-left: 5px solid #88b2a8;
      padding-left: 1rem;
      margin-bottom: 0.5rem;
    }
    .sub {
      color: #5a6f66;
      margin-bottom: 2rem;
      margin-top: 0.25rem;
    }
    .back-link {
      display: inline-block;
      margin-bottom: 2rem;
      background: #2c3e3f;
      color: white;
      padding: 0.5rem 1.2rem;
      border-radius: 40px;
      text-decoration: none;
      font-size: 0.85rem;
      transition: 0.2s;
    }
    .back-link:hover { background: #5f7f6e; }
    .project-gallery {
      margin-bottom: 3rem;
      border-bottom: 1px solid #dce5e0;
      padding-bottom: 2rem;
    }
    .project-gallery h2 {
      font-size: 1.6rem;
      color: #2c3e3f;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .image-pair {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      justify-content: space-between;
      margin-top: 1rem;
    }
    .image-card {
      flex: 1;
      min-width: 240px;
      background: #fafcf9;
      border-radius: 1rem;
      padding: 1rem;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    .image-card img {
      width: 100%;
      height: auto;
      border-radius: 1rem;
      border: 1px solid #cbdcd3;
      background: #eef3f0;
      object-fit: cover;
      max-height: 280px;
    }
    .image-card p {
      margin-top: 0.5rem;
      font-weight: 600;
      color: #2c3e3f;
    }
    .caption {
      font-size: 0.8rem;
      color: #6f8f88;
    }
    @media (max-width: 700px) {
      .image-pair { flex-direction: column; }
      .gallery-container { padding: 1rem; }
    }
  </style>
</head>
<body>
<div class="gallery-container">
  <a href="resume.html" class="back-link"><i class="fas fa-arrow-left"></i> Back to Resume</a>
  <h1>📐 Featured Projects Gallery</h1>
  <div class="sub">Before & after — precision welding and fabrication transformations</div>

